# LM Deck Tools — Apache configuration for the static build (#25).
#
# Copied verbatim into build/ by the static adapter (dotfiles in static/ are
# included), and deployed to /htdocs/decktools/. Every route already resolves
# without rewrite rules because `trailingSlash = 'always'` emits
# collection/index.html rather than collection.html — nothing here is
# load-bearing for routing.
#
# This directory sits inside the main site's document root, so /htdocs/.htaccess
# applies here too. It contributes an HTTPS redirect (which is why none is
# repeated below), an `ErrorDocument 403`, and a PHP handler. Its mod_rewrite
# rules survive because this file declares no `RewriteEngine` of its own —
# adding one here would replace the parent's rules rather than extend them, and
# would silently drop the HTTPS redirect.
#
# Note: Tophost runs PHP in CGI mode, so mod_headers directives do not apply to
# PHP responses. Irrelevant here — every file this serves is static.

# ---------------------------------------------------------------------------
# Error pages
# ---------------------------------------------------------------------------
# 404.html is the adapter's client-rendered shell; the router fails to match the
# unknown path and renders +error.svelte.
#
# The path is document-root-relative, and the document root is the *main site* —
# so it must carry /decktools. A bare /404.html would serve the main site's
# error page, or nothing.
ErrorDocument 404 /decktools/404.html

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	# Everything under _app/immutable is content-hashed: a changed file gets a
	# changed name, so it can be cached for a year and never revalidated.
	<FilesMatch "\.(js|css|woff2?)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	# ...except HTML, which keeps the *same* name across deploys while pointing
	# at new hashed assets. Cache it and a visitor pins an old build.
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>

	# The service worker and the manifest have HTML's property, not the bundle's:
	# same filename forever, different contents every deploy. The worker is the
	# worse of the two — a registration pinned by a year-long `immutable` keeps
	# serving an old app shell with no way to push a fix, which is the classic way
	# to strand every installed user permanently.
	#
	# ORDER MATTERS. `service-worker.js` matches the `\.js$` rule above, and
	# Apache applies <Files>/<FilesMatch> sections in the order they appear, with
	# `Header set` replacing rather than merging. Move this block above that one
	# and the worker silently goes back to being cached for a year.
	<Files "service-worker.js">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</Files>
	<Files "manifest.webmanifest">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</Files>

	<FilesMatch "^(sitemap\.xml|robots\.txt)$">
		Header set Cache-Control "public, max-age=3600"
	</FilesMatch>

	# Images here are the brand marks, not card art — card images come from
	# Scryfall and are cached client-side via the Cache API.
	<FilesMatch "\.(svg|png|ico)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>

	# ---------------------------------------------------------------------
	# Security headers
	# ---------------------------------------------------------------------
	# No CSP on purpose: Svelte injects inline styles, so a strict policy needs
	# a nonce the static adapter cannot mint. Revisit if it ever matters — the
	# app has no login, no cookies and no server-side state to protect.
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json application/xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
	AddType application/manifest+json .webmanifest
	AddType image/svg+xml .svg
</IfModule>
